# Database Connection String
# For Supabase in production: use Transaction Pooler URL on port 6543
# Example: postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:password@localhost:5432/bis_assistant

# JWT Secret for Cookie/Token signing
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# Port for Node.js Express server (default 3000)
PORT=3000

# URL of the AI FastAPI microservice
AI_SERVICE_URL=http://localhost:8000

# URL of the React Frontend (for CORS credentials)
FRONTEND_URL=http://localhost:5173

# Environment (development | production)
NODE_ENV=development
