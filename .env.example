# Fast API Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Data Directories
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Qdrant Vector Database
# Local Docker:
QDRANT_URL=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=bis_documents
# For Qdrant Cloud (uncomment in production):
# QDRANT_URL=https://xxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
RAG_TOP_K=5

# Supabase Storage for Permanent PDF & Chunks Storage (Optional for local dev, Recommended for Cloud)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key
# SUPABASE_STORAGE_BUCKET=bis-documents

# CORS Configuration
FRONTEND_URL=http://localhost:5173
NODE_BACKEND_URL=http://localhost:3000
